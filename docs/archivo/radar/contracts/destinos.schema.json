{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "destinos.schema.json",
  "title": "Destinos del radar",
  "type": "object",
  "additionalProperties": false,
  "required": ["generado", "destinos"],
  "properties": {
    "generado": { "$ref": "comun.schema.json#/$defs/fecha_hora" },
    "destinos": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["destino_id", "nombre", "tipo", "pueblo_magico", "zona", "lat", "lon", "municipios_cvegeo"],
        "properties": {
          "destino_id": { "$ref": "comun.schema.json#/$defs/destino_id" },
          "nombre": { "type": "string" },
          "tipo": { "enum": ["pueblo_magico", "ciudad"] },
          "pueblo_magico": { "type": "boolean" },
          "zona": { "type": "string" },
          "lat": { "type": "number", "minimum": 17.8, "maximum": 20.9 },
          "lon": { "type": "number", "minimum": -99.1, "maximum": -96.7 },
          "municipios_cvegeo": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^21[0-9]{3}$" }
          }
        }
      }
    }
  }
}
