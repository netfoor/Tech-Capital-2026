{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo.schema.json",
  "title": "Geometría del sitio (GeoJSON)",
  "description": "geo/municipios.json y geo/estado.json. Coordenadas WGS84 redondeadas a 4 decimales. Fuente: Marco Geoestadístico del INEGI.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "enum": ["Polygon", "MultiPolygon"] },
              "coordinates": { "type": "array" }
            }
          },
          "properties": {
            "type": "object",
            "required": ["cvegeo", "nombre"],
            "properties": {
              "cvegeo": { "type": "string", "pattern": "^21([0-9]{3})?$" },
              "nombre": { "type": "string" },
              "destino_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
