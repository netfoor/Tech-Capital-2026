---
import Base from '../layouts/Base.astro';
import Acento from '../components/Acento.astro';
---

<Base titulo="Página no encontrada en el Radar de Atención Turística de Puebla">
  <main id="contenido" class="mx-auto max-w-[62ch] px-4 py-24 text-center">
    <h1 class="titulo-seccion">Esta página no existe</h1>
    <Acento class="mx-auto mt-4" />
    <p class="entrada mx-auto mt-5 text-tinta-2">Puede que la dirección esté mal escrita o que la página se haya movido.</p>
    <a class="boton boton-primario mt-8" href="/">Ir al inicio</a>
  </main>
</Base>
