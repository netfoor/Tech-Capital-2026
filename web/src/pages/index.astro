---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Inicio from '../components/Inicio.astro';
import Problema from '../components/Problema.astro';
import LaPlataforma from '../components/LaPlataforma.astro';
import Tianguis from '../components/Tianguis.astro';
import Metodo from '../components/Metodo.astro';
import DatosYCodigo from '../components/DatosYCodigo.astro';
import Pie from '../components/Pie.astro';
---

<Base>
  <Encabezado />
  <main id="contenido">
    <Inicio />
    <Problema />
    <LaPlataforma />
    <Tianguis />
    <Metodo />
    <DatosYCodigo />
  </main>
  <Pie />
</Base>
