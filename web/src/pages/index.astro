---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Inicio from '../components/Inicio.astro';
import Problema from '../components/Problema.astro';
import Radar from '../components/Radar.astro';
import Fichas from '../components/Fichas.astro';
import Asistentes from '../components/Asistentes.astro';
import Redes from '../components/Redes.astro';
import Tianguis from '../components/Tianguis.astro';
import Metodo from '../components/Metodo.astro';
import DatosYCodigo from '../components/DatosYCodigo.astro';
import Pie from '../components/Pie.astro';
---

<Base>
  <Encabezado />
  <main id="contenido">
    <Inicio />
    <Problema />
    <Radar />
    <Fichas />
    <Asistentes />
    <Redes />
    <Tianguis />
    <Metodo />
    <DatosYCodigo />
  </main>
  <Pie />
</Base>
