---
import Seccion from './Seccion.astro';
import { seccion } from '../secciones';
import { VISTAS } from '../vistas';

// Sin Cognito (T010-09 pendiente) la plataforma se publica en modo local.
const conCuentas = Boolean(import.meta.env.PUBLIC_COGNITO_DOMINIO);
---

<Seccion seccion={seccion('plataforma')}>
  <ul class="grid gap-6 min-[760px]:grid-cols-2">
    {
      VISTAS.map((v) => (
        <li class="border border-linea bg-white p-6">
          <img
            class="captura"
            src={`/capturas/${v.id}.png`}
            alt={`Captura de la vista ${v.titulo} de la plataforma`}
            width="1440"
            height="900"
            loading="lazy"
          />
          <h3 class="mt-5 text-[21px]">{v.titulo}</h3>
          <p class="mt-2 text-tinta-2">{v.descripcion}</p>
          <a class="mt-4 inline-block font-bold no-underline" href={`/plataforma/#${v.id}`}>
            Abrir {v.titulo.toLowerCase()}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-10 text-center">
    <a class="boton boton-primario" href="/plataforma/">Entrar a la plataforma</a>
  </p>
  <p class="nota mt-3 text-center">{conCuentas ? 'El acceso es con una cuenta que da de alta el equipo.' : 'Por ahora el acceso es abierto; las cuentas se activan en el piloto.'}</p>
</Seccion>

<style>
  .captura {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    background: var(--color-banda);
    border: 1px solid var(--color-linea);
  }
</style>
