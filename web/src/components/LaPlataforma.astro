---
import Seccion from './Seccion.astro';
import { seccion } from '../secciones';
import { VISTAS } from '../vistas';
---

<Seccion seccion={seccion('plataforma')}>
  {/* T009-14: cada tarjeta lleva una captura real de su vista (public/capturas/). */}
  <ul class="grid gap-6 min-[760px]:grid-cols-2">
    {
      VISTAS.map((v) => (
        <li class="border border-linea bg-white p-6">
          <div class="captura" aria-hidden="true" />
          <h3 class="mt-5 text-[21px]">{v.titulo}</h3>
          <p class="mt-2 text-tinta-2">{v.descripcion}</p>
          <a class="mt-4 inline-block font-bold no-underline" href={`/plataforma/#${v.id}`}>
            Abrir {v.titulo.toLowerCase()}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-10 text-center">
    <a class="boton boton-primario" href="/plataforma/">Entrar a la plataforma</a>
  </p>
  <p class="nota mt-3 text-center">El acceso es con una cuenta que da de alta el equipo.</p>
</Seccion>

<style>
  .captura {
    aspect-ratio: 16 / 10;
    background: var(--color-banda);
    border: 1px solid var(--color-linea);
  }
</style>
