---
import Acento from './Acento.astro';
import { seccion } from '../secciones';
const s = seccion('inicio');
---

<section id="inicio" aria-labelledby="inicio-titulo" class="portada bg-white">
  <div
    class="mx-auto grid max-w-[1320px] items-center gap-10 px-4 sm:px-6 min-[1080px]:grid-cols-[minmax(0,540px)_1fr]"
  >
    <div>
      <h1 id="inicio-titulo" class="titulo-portada">Radar de Atención Turística de Puebla</h1>
      <Acento class="mt-5" />
      <p class="entrada mt-5 text-tinta-2">{s.entrada}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="boton boton-primario max-[760px]:w-full" href="/plataforma/">Entrar a la plataforma</a>
        <a class="boton boton-secundario max-[760px]:w-full" href="#plataforma">Cómo funciona</a>
      </div>
      <p class="nota mt-6">{s.bases}</p>
    </div>
    <figure
      id="mapa-portada"
      class="mapa-portada"
      role="img"
      aria-label="Mapa del estado de Puebla con los Pueblos Mágicos y la capital"
    >
      <p class="cargando-mapa">Cargando el mapa…</p>
    </figure>
  </div>
</section>

<script>
  import { mapaPortada } from '../scripts/mapa.js';
  const figura = document.getElementById('mapa-portada');
  if (figura) {
    mapaPortada(figura).catch((error) => {
      figura.innerHTML = `<p class="cargando-mapa">No se pudo cargar el mapa: ${error.message}</p>`;
    });
  }
</script>

<style is:global>
  .mapa-portada .lienzo-mapa {
    display: block;
    width: 100%;
    height: auto;
  }

  .mapa-portada .etiqueta {
    font-size: 12.5px;
    fill: var(--color-tinta);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .sin-nombres .nombre-punto {
    display: none;
  }

  .mapa-portada .escala-km {
    font-size: 22px;
  }

  .mapa-portada .leyenda-mapa,
  .mapa-portada .fuente-mapa,
  .mapa-portada .cargando-mapa {
    font-size: 12.5px;
    color: var(--color-gris);
  }

  .mapa-portada .leyenda-titulo {
    font-weight: 700;
    color: var(--color-tinta-2);
  }

  .mapa-portada .leyenda-clases {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 4px 0;
    padding: 0;
    list-style: none;
  }

  .mapa-portada .leyenda-clases li {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .mapa-portada .muestra {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 2px;
  }
</style>

<style>
  .portada {
    padding: 72px 0 104px;
  }

  .mapa-portada {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 3 / 4;
    margin: 0 auto;
  }

  @media (max-width: 760px) {
    .portada {
      padding: 40px 0 72px;
    }
  }
</style>
