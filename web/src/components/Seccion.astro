---
import Acento from './Acento.astro';
import type { Seccion } from '../secciones';

interface Props {
  seccion: Seccion;
}
const { seccion } = Astro.props;
const fondo = seccion.numero % 2 === 0 ? 'bg-banda' : 'bg-white';
---

<section id={seccion.id} aria-labelledby={`${seccion.id}-titulo`} class:list={['seccion', fondo]}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <header class="text-center">
      <h2 id={`${seccion.id}-titulo`} class="titulo-seccion">{seccion.titulo}</h2>
      <Acento class="mx-auto mt-4" />
      <p class="entrada mx-auto mt-5 text-tinta-2">{seccion.entrada}</p>
      <p class="nota mx-auto mt-3 max-w-[62ch]">{seccion.bases}</p>
    </header>
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>

<style>
  .seccion {
    padding: 104px 0;
    border-top: 1px solid var(--color-linea);
  }

  @media (max-width: 760px) {
    .seccion {
      padding: 72px 0;
    }
  }
</style>
