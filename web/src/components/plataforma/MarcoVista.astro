---
// Marco común de cada vista: título, descripción, filtros (slot "filtros") y contenido o estado vacío.
import type { Vista } from '../../vistas';

interface Props {
  vista: Vista;
}
const { vista } = Astro.props;
---

<section data-vista={vista.id} aria-labelledby={`vista-${vista.id}-titulo`} hidden class="vista-marco">
  <div class="principal">
    <header>
      <h1 id={`vista-${vista.id}-titulo`} class="text-[26px] leading-tight">{vista.titulo}</h1>
      <p class="mt-1 max-w-[70ch] text-tinta-2">{vista.descripcion}</p>
    </header>
    <div class="filtros mt-5 flex flex-wrap gap-3">
      <slot name="filtros" />
    </div>
    <div id={`${vista.id}-contenido`} class="mt-6">
      <p class="vacio border border-dashed border-linea bg-banda px-5 py-10 text-center text-tinta-2">
        {vista.vacio}
      </p>
    </div>
  </div>
  <slot name="lateral" />
</section>

<style>
  .vista-marco:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .vista-marco.con-panel {
    grid-template-columns: minmax(0, 1fr) 420px;
  }

  @media (max-width: 1079px) {
    .vista-marco.con-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
