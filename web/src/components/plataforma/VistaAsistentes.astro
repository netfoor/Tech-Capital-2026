---
// T009-08: visibilidad por idioma y proveedor, dominios citados y un ejemplo, desde asistentes.json.
import MarcoVista from './MarcoVista.astro';
import { VISTAS } from '../../vistas';
const vista = VISTAS.find((v) => v.id === 'asistentes')!;
---

<MarcoVista vista={vista}>
  <Fragment slot="filtros" />
</MarcoVista>

<script>
  import { montarAsistentes } from '../../scripts/vista-asistentes.js';
  const contenedor = document.getElementById('asistentes-contenido');
  const filtros = document.querySelector('[data-vista="asistentes"] .filtros');
  if (contenedor && filtros) {
    montarAsistentes(contenedor, filtros).catch((error) => {
      contenedor.innerHTML = `<p class="aviso-error">No se pudieron cargar las corridas de asistentes: ${error.message}</p>`;
    });
  }
</script>

<style is:global>
  .alterna {
    display: inline-flex;
    flex-wrap: wrap;
  }

  .alterna button {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--color-tinta);
    margin-left: -1px;
    background: #fff;
    color: var(--color-tinta);
  }

  .alterna button[aria-pressed='true'] {
    background: var(--color-tinta);
    color: #fff;
    font-weight: 700;
  }

  .rejilla-asistentes {
    display: grid;
    gap: 32px;
    margin-top: 16px;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }

  @media (max-width: 1079px) {
    .rejilla-asistentes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .subtitulo-vista {
    font-weight: 700;
    margin-bottom: 8px;
  }

  .barras-vis,
  .dom-tabla {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .barra-vis {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    cursor: pointer;
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .barra-vis {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    .bv-texto {
      grid-column: 2;
    }
  }

  .barra-vis.seleccionado {
    background: var(--color-fila-sel);
    box-shadow: inset 3px 0 0 var(--color-sel);
  }

  .bv-pista {
    position: relative;
    height: 14px;
    background: var(--color-rejilla);
  }

  .bv-valor {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--color-tc-azul);
    transition: width 0.45s ease;
  }

  .bv-ic {
    position: absolute;
    top: 6px;
    height: 2px;
    background: var(--color-tinta);
    transition: left 0.45s ease, width 0.45s ease;
  }

  .bv-texto {
    min-width: 130px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .dom-tabla li {
    display: flex;
    flex-direction: column;
    padding: 6px 0;
    border-bottom: 1px solid var(--color-linea);
  }

  .ejemplo-prompt {
    font-weight: 700;
  }

  .ejemplo-resp {
    margin: 6px 0;
    padding: 6px 12px;
    border-left: 3px solid var(--color-linea);
    color: var(--color-tinta-2);
    font-size: 15px;
  }

  @media (prefers-reduced-motion: reduce) {
    .bv-valor,
    .bv-ic {
      transition: none;
    }
  }
</style>
