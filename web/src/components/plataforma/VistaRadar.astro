---
// T009-06: mapa por brecha, atención contra desempeño y gráfica de cuadrantes, desde radar.json.
import MarcoVista from './MarcoVista.astro';
import PanelFicha from './PanelFicha.astro';
import { VISTAS } from '../../vistas';
const vista = VISTAS.find((v) => v.id === 'radar')!;
---

<MarcoVista vista={vista}>
  <PanelFicha slot="lateral" />
</MarcoVista>

<script>
  import { montarRadar } from '../../scripts/vista-radar.js';
  const contenedor = document.getElementById('radar-contenido');
  if (contenedor) {
    montarRadar(contenedor).catch((error) => {
      contenedor.innerHTML = `<p class="aviso-error">No se pudieron cargar los datos del radar: ${error.message}</p>`;
    });
  }
</script>

<style is:global>
  .sin-nombres .nombre-punto {
    display: none;
  }

  .mapa-brecha .escala-km {
    font-size: 22px;
  }

  .nota-radar {
    max-width: 70ch;
    font-size: 14.5px;
    color: var(--color-gris);
  }

  /* Arriba solo el mapa; la gráfica de brechas y la de cuadrantes van debajo. */
  .rejilla-radar {
    display: grid;
    margin-top: 16px;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .mapa-brecha {
    width: 100%;
    max-width: 560px;
  }

  .mapa-brecha .lienzo-mapa {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    margin: 0 auto;
  }

  .mapa-brecha .etiqueta,
  .cuadrantes .etiqueta {
    font-size: 12.5px;
    fill: var(--color-tinta);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .mapa-brecha .leyenda-mapa,
  .mapa-brecha .fuente-mapa {
    font-size: 12.5px;
    color: var(--color-gris);
  }

  .mapa-brecha .leyenda-clases {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 4px 0;
    padding: 0;
    list-style: none;
  }

  .mapa-brecha .leyenda-clases li {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .mapa-brecha .muestra {
    display: inline-block;
    width: 14px;
    height: 14px;
  }

  .cuadrantes {
    margin-top: 192px;
  }

  .brechas {
    position: relative;
    margin: 176px auto 0;
    max-width: 960px;
  }

  .brechas text {
    font-size: 13px;
    fill: var(--color-tinta);
  }

  .brechas .eje,
  .brechas .leyenda-brechas text {
    fill: var(--color-gris);
    font-size: 12.5px;
  }

  .brechas .valor-brecha {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .fila-brecha {
    cursor: pointer;
    outline: none;
  }

  .fila-brecha:hover .fondo-fila,
  .fila-brecha:focus-visible .fondo-fila {
    fill: var(--color-banda);
  }

  .fila-brecha.seleccionado .fondo-fila {
    fill: var(--color-fila-sel);
  }

  .fila-brecha.seleccionado .nombre-fila {
    font-weight: 700;
  }

  .tip-brecha {
    position: absolute;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 220px;
    padding: 8px 10px;
    background: #fff;
    border: 1px solid var(--color-linea);
    box-shadow: 0 4px 12px rgb(17 24 39 / 0.08);
    font-size: 13px;
    color: var(--color-tinta);
    pointer-events: none;
  }

  .tip-brecha span {
    color: var(--color-tinta-2);
  }

  .cuadrantes .eje {
    font-size: 12.5px;
    fill: var(--color-gris);
  }

  .cuadrantes .rotulo-cuadrante {
    font-size: 13px;
    font-weight: 700;
  }

  .punto-radar,
  .punto-cuadrante {
    cursor: pointer;
    outline: none;
  }

  .anillo-sel {
    stroke: none;
  }

  .seleccionado > .anillo-sel,
  .punto-radar:focus-visible > .anillo-sel,
  .punto-cuadrante:focus-visible > .anillo-sel {
    stroke: var(--color-sel);
    stroke-width: 2.5;
  }

  .aviso-error {
    border-left: 4px solid var(--color-error);
    padding: 12px 16px;
    background: #fff;
  }
</style>

<style is:global>
  @media (max-width: 479px) {
    .brechas .nombre-fila {
      font-size: 12px;
    }
  }
</style>
