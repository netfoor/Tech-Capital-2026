---
// T009-07: las 12 fichas con «Descargar para la cita», desde fichas/<destino_id>.json.
import MarcoVista from './MarcoVista.astro';
import { VISTAS } from '../../vistas';
const vista = VISTAS.find((v) => v.id === 'fichas')!;
---

<MarcoVista vista={vista} />

<script>
  import { montarFichas } from '../../scripts/ficha.js';
  const contenedor = document.getElementById('fichas-contenido');
  if (contenedor) {
    montarFichas(contenedor).catch((error) => {
      contenedor.innerHTML = `<p class="aviso-error">No se pudieron cargar las fichas: ${error.message}</p>`;
    });
  }
</script>
