---
import { SECCIONES } from '../secciones';
const primera = SECCIONES[0];
---

<header class="sticky top-0 z-40 bg-white">
  <div
    class="mx-auto flex h-16 max-w-[1320px] items-center justify-between gap-4 px-4 max-[760px]:h-14 sm:px-6"
  >
    <a href="#inicio" class="font-bold text-tinta no-underline">Radar de Atención Turística</a>

    <nav aria-label="Secciones" class="relative" id="nav-secciones">
      <button
        id="menu-secciones"
        type="button"
        aria-expanded="false"
        aria-controls="lista-secciones"
        class="flex min-h-11 items-center gap-2 border border-linea px-3 text-[15px] text-tinta"
      >
        <span class="contador num text-gris"><span data-numero>{primera.numero}</span> de {SECCIONES.length}</span>
        <span data-titulo class="font-bold">{primera.titulo}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
      <ol
        id="lista-secciones"
        hidden
        class="absolute right-0 mt-2 w-72 border border-linea bg-white py-1 shadow-[0_8px_24px_rgba(17,24,39,0.12)]"
      >
        {
          SECCIONES.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                data-seccion={s.id}
                data-titulo={s.titulo}
                class="flex gap-3 px-4 py-2 text-tinta no-underline hover:bg-banda"
              >
                <span class="num w-4 text-gris">{s.numero}</span>
                <span>{s.titulo}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
  <div class="riel" aria-hidden="true"><div class="riel-avance"></div></div>
</header>

<style>
  .riel {
    position: relative;
    height: 2px;
    background: var(--color-linea);
  }

  .riel-avance {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: calc(var(--avance, 0) * 100%);
    background: var(--color-tc-azul);
  }

  .riel-avance::after {
    content: '';
    position: absolute;
    top: -3px;
    right: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-tc-azul);
  }

  a[aria-current='true'] {
    font-weight: 700;
    box-shadow: inset 3px 0 0 var(--color-sel);
  }

  @media (max-width: 420px) {
    .contador {
      display: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav-secciones') as HTMLElement;
  const boton = document.getElementById('menu-secciones') as HTMLButtonElement;
  const lista = document.getElementById('lista-secciones') as HTMLOListElement;
  const numero = boton.querySelector('[data-numero]') as HTMLElement;
  const titulo = boton.querySelector('[data-titulo]') as HTMLElement;
  const avance = document.querySelector('.riel-avance') as HTMLElement;
  const enlaces = [...lista.querySelectorAll<HTMLAnchorElement>('a[data-seccion]')];

  function abrir(abierto: boolean) {
    boton.setAttribute('aria-expanded', String(abierto));
    lista.hidden = !abierto;
  }

  boton.addEventListener('click', () => abrir(lista.hidden));
  enlaces.forEach((a) => a.addEventListener('click', () => abrir(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lista.hidden) {
      abrir(false);
      boton.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!lista.hidden && !nav.contains(e.target as Node)) abrir(false);
  });

  // Sección actual: la que cruza la mitad de la pantalla.
  const secciones = enlaces
    .map((a) => document.getElementById(a.dataset.seccion ?? ''))
    .filter((s): s is HTMLElement => s !== null);

  const observador = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        const i = secciones.indexOf(entrada.target as HTMLElement);
        if (i < 0) continue;
        numero.textContent = String(i + 1);
        titulo.textContent = enlaces[i].dataset.titulo ?? '';
        enlaces.forEach((a, j) => {
          if (j === i) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  secciones.forEach((s) => observador.observe(s));

  // Riel de avance: proporción recorrida de la página.
  function medir() {
    const maximo = document.documentElement.scrollHeight - window.innerHeight;
    const valor = maximo > 0 ? Math.min(1, Math.max(0, window.scrollY / maximo)) : 0;
    avance.style.setProperty('--avance', String(valor));
  }
  window.addEventListener('scroll', medir, { passive: true });
  window.addEventListener('resize', medir);
  new ResizeObserver(medir).observe(document.body);
  medir();
</script>
