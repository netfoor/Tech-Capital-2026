---
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  indexar?: boolean;
}
const {
  titulo = 'Radar de Atención Turística de Puebla',
  descripcion = 'Atención digital y desempeño turístico de los Pueblos Mágicos de Puebla, con datos verificables.',
  indexar = true,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {!indexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2"
      >Saltar al contenido</a
    >
    <slot />
  </body>
</html>
