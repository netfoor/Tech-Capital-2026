# Copia este archivo como .env y llena lo que necesites. El archivo .env nunca se versiona.

# Base de datos local (docker compose expone PostGIS en el puerto 5433)
DATABASE_URL=postgresql+psycopg://pueblaviva:pueblaviva@localhost:5433/pueblaviva
DB_PUERTO=5433

# Umbral k de privacidad para los agregados del tablero (§14). En producción, al menos 10
K_MINIMO=10

# Firma de las sesiones JWT del MVP (spec 014). Usa una cadena larga y aleatoria
JWT_SECRETO=

# Cuenta de analista para la demostración del tablero (spec 019). Llena tus propios valores
DEMO_ANALISTA_CORREO=
DEMO_ANALISTA_CONTRASENA=

# Token gratuito de la API DENUE de INEGI (spec 012)
INEGI_DENUE_TOKEN=

# Opcional: modelo con salida estructurada para clasificar reseñas (spec 018, P1)
OPENAI_API_KEY=
