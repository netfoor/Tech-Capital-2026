# Copia este archivo como .env y llena las llaves. El archivo .env nunca se versiona.

# YouTube Data API v3 (spec 004)
YOUTUBE_API_KEY=

# OpenAI: Responses API con la herramienta web_search (specs 006 y 007)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini API con la herramienta google_search (spec 006)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Tope de corridas de asistentes por ejecución (FR-006-06)
RADAR_MAX_CORRIDAS=600
